#: soapbox-blyg.php
msgid "https://github.com/cyberscribe/soapbox-blyg"
msgstr "https://github.com/cyberscribe/soapbox-blyg"

#. Description of the plugin
#: soapbox-blyg.php
msgid "Publishes your posts as a blyg under the Blygger protocol: stable ids, versions, pins and a feed that other Blygger clients can subscribe to and quote. An independent implementation."
msgstr "Publica seus posts como um blyg segundo o protocolo Blygger: IDs estáveis, versões, versões fixadas e um feed que outros clientes Blygger podem assinar e citar. Uma implementação independente."

#. Author of the plugin
#: soapbox-blyg.php
msgid "Robert Peake"
msgstr "Robert Peake"

#. Author URI of the plugin
#: soapbox-blyg.php
msgid "https://www.robertpeake.com/"
msgstr "https://www.robertpeake.com/"

